NODE_ENV=production
PORT=<railway-port>

DB_HOST=<railway-postgres-host>
DB_PORT=<railway-postgres-port>
DB_USERNAME=<railway-postgres-user>
DB_PASSWORD=<railway-postgres-password>
DB_DATABASE=<railway-postgres-db>
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_MIGRATIONS_RUN=false

JWT_SECRET=<strong-secret>
JWT_EXPIRES_IN=24h

CORS_ORIGINS=https://e-engineer-staging.vercel.app
FRONTEND_URL=https://e-engineer-staging.vercel.app
API_PUBLIC_URL=https://e-engineer-api-staging.up.railway.app

AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
